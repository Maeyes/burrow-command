{
  "schemaVersion": 1,
  "provider": "PixelLab",
  "integrationStatus": "generation-required",
  "pixelPolicy": {
    "background": "transparent-rgba",
    "interpolation": "none",
    "heroBakedIn": false,
    "weaponBakedIn": false
  },
  "effects": [
    {
      "id": "sword-medium-slash-trail",
